# =============================================================================
# RLM Configuration - Copy this to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# ROOT LLM Configuration (the main LLM that writes code/uses tools)
# Pick ONE option and comment out the other.
# -----------------------------------------------------------------------------

# Option A — vLLM (OpenAI-compatible endpoint)
ROOT_PROVIDER=vllm                          # Options: vllm, ollama, openai
ROOT_BASE_URL=http://172.16.2.214:8000/v1   # API endpoint
ROOT_API_KEY=abc                            # API key (use 'abc' for vLLM if no auth)
ROOT_MODEL=openai/gpt-oss-20b               # Model name as served by vLLM

# Option B — Ollama
# ROOT_PROVIDER=ollama
# ROOT_BASE_URL=https://ollama-ijcare-gpt.sheikhibrar.com
# ROOT_API_KEY=                             # Not needed for Ollama
# ROOT_MODEL=gpt-oss:20b                    # Model name as pulled in Ollama

# -----------------------------------------------------------------------------
# SUB LLM Configuration (helper LLMs for chunk analysis)
# Leave empty to use same as ROOT
# -----------------------------------------------------------------------------
SUB_PROVIDER=                               # Options: vllm, ollama, openai (empty = same as ROOT)
SUB_BASE_URL=                               # API endpoint (empty = same as ROOT)
SUB_API_KEY=                                # API key (empty = same as ROOT)
SUB_MODEL=                                  # Model name (empty = same as ROOT)

# -----------------------------------------------------------------------------
# Mode Selection
# -----------------------------------------------------------------------------
# repl  = LLM writes Python code (works with any model)
# tools = LLM uses tool calling (requires model with tool support, e.g., Ollama)
DEFAULT_MODE=repl

# -----------------------------------------------------------------------------
# Safeguards & Limits
# -----------------------------------------------------------------------------
MAX_ITERATIONS=30                           # Max ROOT LLM loops
MAX_SUB_LLM_CALLS=20                        # Max sub-LLM calls per query
MAX_RECURSION_DEPTH=1                       # Sub-LLMs can't spawn sub-sub-LLMs
CALL_TIMEOUT=60                             # Seconds per API call
TOTAL_TIMEOUT=600                           # Total seconds for entire query

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------
DEFAULT_CHUNK_SIZE=4000                     # Characters per chunk

# -----------------------------------------------------------------------------
# Delays (useful for rate-limited or "thinking" models)
# -----------------------------------------------------------------------------
CALL_DELAY=0                                # Seconds to wait between calls

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
VERBOSE=false                               # Enable verbose output
